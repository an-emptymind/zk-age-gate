# Copy to .env and fill in.  ->  cp .env.example .env
#
# .env is gitignored. Never commit it, never paste its contents anywhere.
#
# USE A THROWAWAY KEY. This account only ever needs Sepolia test ETH.
# Do not reuse a key that holds mainnet funds or controls anything real.
# Faucets: https://sepoliafaucet.com  |  https://www.alchemy.com/faucets/ethereum-sepolia

# Any Sepolia RPC. The public one below works but is rate-limited;
# an Alchemy/Infura URL is more reliable for repeated runs.
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Deployer key, 0x-prefixed. Needs ~0.02 Sepolia ETH for both deployments.
PRIVATE_KEY=

# From https://etherscan.io/myapikey — needed only for source verification.
# Deployment works without it; you just won't get verified source.
ETHERSCAN_API_KEY=
